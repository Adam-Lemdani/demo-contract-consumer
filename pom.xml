<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example.demo</groupId>
    <artifactId>demo-contract-consumer</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>demo-contract-consumer</name>
    <description>Spring Cloud Contract consumer demo (Stub Runner, StubsMode.LOCAL)</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>

        <!--
          Provider stub coordinates. The consumer's UPSTREAM dependency is
          declared for Spring in src/test/resources/application.yml (stubrunner.ids);
          the version is overridable so cross-repo CI can point at the exact
          coordinates it just installed into the runner-local .m2:
              mvn test -Dprovider.stubs.version=1.0.0-SNAPSHOT
          These pom properties are forwarded to the test JVM via surefire
          systemPropertyVariables (below) and resolved as ${...} in application.yml.
        -->
        <provider.stubs.groupId>com.example.demo</provider.stubs.groupId>
        <provider.stubs.artifactId>demo-contract-provider</provider.stubs.artifactId>
        <provider.stubs.version>1.0.0-SNAPSHOT</provider.stubs.version>

        <!-- Default off; the breaking-demo profile flips this to true. -->
        <breaking.demo.enabled>false</breaking.demo.enabled>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Consumer-side verification: replays the provider stubs locally. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-contract-stub-runner</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Forward selected Maven properties into the forked test JVM so that
              application.yml placeholders (${provider.stubs.version},
              ${breaking.demo.enabled}) resolve. Overriding on the command line
              (e.g. -Dprovider.stubs.version=...) flows straight through.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <provider.stubs.version>${provider.stubs.version}</provider.stubs.version>
                        <breaking.demo.enabled>${breaking.demo.enabled}</breaking.demo.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Demonstration profile that runs the deliberately breaking consumer test.
          Off by default so `mvn test` stays green. Enable with:
              mvn test -Pbreaking-demo
        -->
        <profile>
            <id>breaking-demo</id>
            <properties>
                <breaking.demo.enabled>true</breaking.demo.enabled>
            </properties>
        </profile>
    </profiles>
</project>
